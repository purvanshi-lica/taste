# ---------------------------------------------------------------------------
# taste-scorer .gitignore (standalone public release)
# ---------------------------------------------------------------------------

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Model weights / checkpoints ---
# Checkpoints are fetched, not committed.  Keep the directory's README only.
*.pt
*.pth
*.safetensors
*.ckpt
*.bin
lora_adapter/
checkpoints/*
!checkpoints/README.md

# --- Data ---
# The dataset is fetched from the HF Hub (masked for designer privacy), never
# committed.  Keep the processing scripts + README; ignore everything fetched
# or derived (raw snapshot, ranking CSVs, battles).
data/*
!data/README.md
!data/process.py
!data/requirements.txt
data/raw/
data/rankings/
data/battles.csv
*.parquet
images/

# --- Local results (kept on disk for paper reference, NOT shared) ---
# Sweep reports, premodel.tex, and any eval outputs live here locally but are
# intentionally excluded from the public repo.  Keep only the README.
results/*
!results/README.md

# --- Run outputs ---
scored*.csv
*_scored.csv
*.html
wandb/
runs/
outputs/
logs/
*.log

# --- HuggingFace / Torch caches (if ever placed in-tree) ---
.cache/
hf_cache/

# --- OS / editor noise ---
.DS_Store
__MACOSX/
*.swp
*~
.idea/
.vscode/

# --- Analysis reproduction outputs (regenerated; never committed) ---
analysis/distribution_tests/figures/
analysis/distribution_tests/stats/
analysis/vlm_judge/**/*.jsonl
analysis/vlm_judge/pair_jsonl/
analysis/vlm_judge/results/
analysis/**/runs/
# Auto-generated reports (regenerated by aggregate_report.py / hallucination_agreement.py)
analysis/**/DISTRIBUTION_TEST_REPORT.md
analysis/**/HALLUCINATION_AGREEMENT_REPORT*.md
# Reference-anchor arrays are DATA (derived from third-party datasets), fetched
# separately like the dataset/checkpoints — never committed. Keep only the README.
analysis/distribution_tests/refs/*.npy
!analysis/distribution_tests/refs/README.md
# vlm_judge/reports/*.md summaries (model-level, name-free) are tracked as docs;
# the machine-readable *.json result dumps are NOT committed.
analysis/vlm_judge/reports/*.json

# Internal working docs (research notes, not part of the public release).
analysis/vlm_judge/LITERATURE_ALIGNMENT.md
